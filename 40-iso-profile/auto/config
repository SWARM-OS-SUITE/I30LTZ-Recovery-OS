#!/bin/sh
# I30LTZ Recovery OS — lb config
# Version: 0.4.0-alpha | Date: 2026-10-07
# Debian 13 (trixie) — live-build 1:20250505+ (Debian mode)
# Run from: /mnt/recoverybuild/40-iso-profile/
# -------------------------------------------------------
# Notes:
#   - config/{binary,bootstrap,chroot,common,source} are generated by this
#     script; they are not hand-edited and not tracked in git.
#   - Live boot is live-boot/live-config (boot=live), not Ubuntu casper.
#   - Username/hostname are live-config boot params; hostname is also set
#     in hook 0400-system-config.
#   - non-free-firmware is enabled so the live system can drive real-world
#     NICs, Wi-Fi and storage controllers on machines being repaired.
# -------------------------------------------------------

set -e

lb config noauto \
  --mode                   debian \
  --distribution           trixie \
  --architectures          amd64 \
  --linux-flavours         amd64 \
  --binary-images          iso-hybrid \
  --bootloaders            "syslinux,grub-efi" \
  --debian-installer       none \
  --mirror-bootstrap       "http://deb.debian.org/debian/" \
  --mirror-chroot          "http://deb.debian.org/debian/" \
  --mirror-binary          "http://deb.debian.org/debian/" \
  --mirror-chroot-security "http://security.debian.org/debian-security/" \
  --mirror-binary-security "http://security.debian.org/debian-security/" \
  --archive-areas          "main contrib non-free non-free-firmware" \
  --apt-recommends         false \
  --security               true \
  --updates                true \
  --firmware-chroot        true \
  --firmware-binary        true \
  --bootappend-live        "boot=live components persistence live-config.username=liveuser live-config.hostname=i30ltz-recovery quiet" \
  --memtest                memtest86+ \
  --iso-volume             "I30LTZ_RECOVERY_v0.4" \
  --iso-publisher          "I30LTZ Project 2026-10-07" \
  --iso-application        "I30LTZ Recovery OS" \
  --checksums              sha256 \
  --chroot-squashfs-compression-type xz \
  "${@}"
