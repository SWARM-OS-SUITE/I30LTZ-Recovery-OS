# I30LTZ Recovery OS - NETWORK POLICY (single source of truth)
# Version: 0.3.1-alpha | Date: 2026-10-05
# Read by: mad-dr-boltz.service, i30ltz-net (firewall), i30ltz CLI.
# Do NOT set bind addresses anywhere else.
#
# BOLTZ_EXPOSE=private  -> Boltz API reachable from this machine + LAN + Tailscale
#                          (RFC1918, 100.64.0.0/10). NEVER the public internet.
#                          Required for the Android + desktop companion apps.
# BOLTZ_EXPOSE=local    -> loopback only (companions cannot connect)
#
# Ollama is NOT configurable here on purpose: it is always 127.0.0.1:11434
# and the firewall drops 11434 from everything but loopback.
BOLTZ_EXPOSE=private
BOLTZ_PORT=5000
