# I30LTZ Recovery OS v0.1.0 · 2026-10-01 — Dr. I30LTZ console, full screen on tty1
# Runs on the Linux text console (no graphics stack), so it still works when
# GPU drivers don't — the right default for a recovery OS.
[Unit]
Description=I30LTZ Recovery OS kiosk (Dr. I30LTZ console)
After=systemd-user-sessions.service plymouth-quit-wait.service i30ltz-firstboot.service
Wants=i30ltz-firstboot.service
Conflicts=getty@tty1.service

[Service]
User=i30ltz
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=tty
StandardError=tty
UtmpIdentifier=tty1
UtmpMode=user
Environment=TERM=linux
ExecStartPre=+-/usr/bin/setvtrgb -C /dev/tty1 /etc/i30ltz/vtrgb
ExecStartPre=+-/usr/bin/setfont -C /dev/tty1 /usr/share/consolefonts/Lat15-TerminusBold32x16.psf.gz
ExecStart=/opt/i30ltz/bin/i30ltz-console
Restart=always
RestartSec=1

[Install]
WantedBy=graphical.target
