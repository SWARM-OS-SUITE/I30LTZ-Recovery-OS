# I30LTZ Recovery OS v0.1.0 · 2026-10-01 — one-time setup: password, timezone, Wi-Fi
[Unit]
Description=I30LTZ Recovery OS first-boot setup
After=systemd-user-sessions.service plymouth-quit-wait.service NetworkManager.service
Before=i30ltz-kiosk.service
ConditionPathExists=!/var/lib/i30ltz/firstboot.done

[Service]
Type=oneshot
RemainAfterExit=yes
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=tty
ExecStartPre=-/usr/bin/plymouth quit
ExecStartPre=-/usr/bin/setvtrgb -C /dev/tty1 /etc/i30ltz/vtrgb
ExecStartPre=-/usr/bin/setfont -C /dev/tty1 /usr/share/consolefonts/Lat15-TerminusBold32x16.psf.gz
ExecStart=/opt/i30ltz/bin/i30ltz-firstboot

[Install]
WantedBy=graphical.target
